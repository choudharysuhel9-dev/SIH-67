# ============================================================
# Member 5 — Ocean Data Optimization Layer — .gitignore
# ============================================================

# ----- NetCDF datasets (NEVER commit — can be gigabytes) -----
*.nc
*.nc4
*.ncdf

# ----- Python cache -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Virtual environments -----
venv/
.venv/
env/
.env/

# ----- Environment / credentials (NEVER commit) -----
.env
.env.*
*.env
credentials/
credentials.json
secrets.json
api_keys.txt
*.key
*.pem

# ----- Build artifacts -----
dist/
build/
*.egg-info/
*.egg

# ----- IDEs -----
.idea/
.vscode/
*.swp
*.swo

# ----- OS files -----
.DS_Store
Thumbs.db

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- Coverage -----
.coverage
htmlcov/
coverage.xml

# Old development experiments
archive/
